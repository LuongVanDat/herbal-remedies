  "dau_hieu_nguy_hiem": [
    { "ten": "Đau chói cả hai bên sườn, đau liên tục, cảm giác bó chặt lấy ngực hoặc bụng; ấn cột sống có điểm đau chói", "trang": 64 },
    { "ten": "Sốt về chiều, mệt mỏi, sút cân", "trang": 64 },
    { "ten": "Biến dạng cột sống", "trang": 64 },
    { "ten": "Đau rát một mảng sườn rồi đỏ da, xuất hiện mụn nước lan theo khoang liên sườn, sốt nhẹ, đau hạch nách", "trang": 64 },
    { "ten": "Đau sau chấn thương cột sống", "trang": 64 }
